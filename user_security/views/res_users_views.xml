<odoo>

    <record id="res_users_form_security" model="ir.ui.view">
        <field name="name">res.users.form.security</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Security" groups="user_security.group_security_admin">
                    <group>
                        <field name="security_protected"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
