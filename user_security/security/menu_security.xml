<odoo>

    <!-- Only Security Administrators may see (and therefore manage) the Users
         and Groups menus. A plain Settings administrator keeps access to the
         rest of the Settings app. -->
    <record id="base.menu_action_res_users" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('user_security.group_security_admin')])]"/>
    </record>
    <record id="base.menu_action_res_groups" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('user_security.group_security_admin')])]"/>
    </record>

</odoo>
